# Build llama.cpp + profiler natively on aarch64 via QEMU
# Usage: docker buildx build --platform linux/arm64 -f Dockerfile.aarch64-native ...
FROM ubuntu:22.04

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y \
    cmake make g++ git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Clone llama.cpp fresh
RUN git clone --depth 1 --recurse-submodules https://github.com/ggml-org/llama.cpp.git /build/llama.cpp

# Copy profiler source
COPY collection/track1_ggml/llm_profiler_main.cpp /build/profiler/llm_profiler_main.cpp

# Patch CMakeLists.txt
RUN printf '\nadd_executable(llm-profiler /build/profiler/llm_profiler_main.cpp)\ntarget_link_libraries(llm-profiler PRIVATE common llama ggml)\ntarget_include_directories(llm-profiler PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/common ${CMAKE_CURRENT_SOURCE_DIR}/include ${CMAKE_CURRENT_SOURCE_DIR}/ggml/include)\n' >> /build/llama.cpp/CMakeLists.txt

RUN cd /build/llama.cpp && mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DGGML_CPU=ON \
        -DGGML_NATIVE=OFF \
        -DLLAMA_CURL=OFF \
        -DBUILD_SHARED_LIBS=OFF \
    && cmake --build . --target llm-profiler llama-quantize -j$(nproc)

RUN mkdir -p /output && \
    find /build/llama.cpp/build -name "llm-profiler" -type f -exec cp {} /output/ \; && \
    find /build/llama.cpp/build -name "llama-quantize" -type f -exec cp {} /output/ \;

CMD ["ls", "-la", "/output/"]
