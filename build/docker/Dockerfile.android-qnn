# Build llama.cpp + profiler for Android with QNN NPU backend
# Uses chraac's Docker image (includes QAIRT 2.42.0 + NDK)
FROM --platform=linux/amd64 chraac/llama-cpp-qnn-builder:latest

SHELL ["/bin/bash", "-c"]

WORKDIR /build

# Copy our profiler source and the QNN-patched llama.cpp fork
COPY collection/track1_ggml/llm_profiler_main.cpp /build/profiler/llm_profiler_main.cpp
COPY vendor/llama-cpp-qnn/llama.cpp/ /build/llama.cpp/

# Patch CMakeLists.txt to add our profiler
RUN printf '\nadd_executable(llm-profiler /build/profiler/llm_profiler_main.cpp)\ntarget_link_libraries(llm-profiler PRIVATE common llama ggml)\ntarget_include_directories(llm-profiler PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/common ${CMAKE_CURRENT_SOURCE_DIR}/include ${CMAKE_CURRENT_SOURCE_DIR}/ggml/include)\n' >> /build/llama.cpp/CMakeLists.txt

# Use Docker image's built-in QAIRT SDK (2.42.0)
# QNN_SDK_PATH is already set in the base image
RUN source ${QNN_SDK_PATH}/bin/envsetup.sh && \
    mkdir -p /build/out && cd /build/out && \
    cmake /build/llama.cpp \
        -DCMAKE_TOOLCHAIN_FILE=${ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake \
        -DANDROID_ABI=arm64-v8a \
        -DANDROID_PLATFORM=android-31 \
        -DCMAKE_BUILD_TYPE=Release \
        -DGGML_QNN=ON \
        -DGGML_NATIVE=OFF \
        -DLLAMA_CURL=OFF \
        -DBUILD_SHARED_LIBS=OFF \
    && cmake --build . --target llm-profiler -j$(nproc)

# Collect output binary + QNN runtime libs
RUN mkdir -p /output && \
    find /build/out -name "llm-profiler" -type f -exec cp {} /output/ \; && \
    find /build/out -name "*.so" -exec cp {} /output/ \; && \
    cp ${QNN_SDK_PATH}/lib/aarch64-android/libQnnHtp.so /output/ && \
    cp ${QNN_SDK_PATH}/lib/aarch64-android/libQnnHtpPrepare.so /output/ && \
    cp ${QNN_SDK_PATH}/lib/aarch64-android/libQnnSystem.so /output/ && \
    cp ${QNN_SDK_PATH}/lib/aarch64-android/libQnnCpu.so /output/ && \
    cp ${QNN_SDK_PATH}/lib/aarch64-android/libQnnHtpV73Stub.so /output/ && \
    cp ${QNN_SDK_PATH}/lib/aarch64-android/libQnnHtpV75Stub.so /output/ && \
    cp ${QNN_SDK_PATH}/lib/aarch64-android/libQnnHtpV79Stub.so /output/

CMD ["ls", "-la", "/output/"]
